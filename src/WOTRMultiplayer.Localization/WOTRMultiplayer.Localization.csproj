<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net481</TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\WOTRMultiplayer.Localization.Generator\WOTRMultiplayer.Localization.Generator.csproj" />
	</ItemGroup>
	<Target Name="GenerateLocalizationKeys" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
		<Exec Command="&quot;$(ProjectDir)..\WOTRMultiplayer.Localization.Generator\bin\$(Configuration)\net481\WOTRMultiplayer.Localization.Generator.exe&quot;" WorkingDirectory="$(ProjectDir)" />
	</Target>
</Project>
