<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RtwpProbeModPath Condition="'$(RtwpProbeModPath)' == ''">$(MSBuildThisFileDirectory)..\..\src\WOTRMultiplayer\bin\Release\net481\WOTRMultiplayer.dll</RtwpProbeModPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AutoMapper">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(RtwpProbeModPath)'))\AutoMapper.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="WOTRMultiplayer">
      <HintPath>$(RtwpProbeModPath)</HintPath>
    </Reference>
    <Reference Include="WOTRMultiplayer.Networking">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(RtwpProbeModPath)'))\WOTRMultiplayer.Networking.dll</HintPath>
    </Reference>
    <!-- protobuf-net discovers this transitive dependency at runtime. Resolve
         the exact packaged DLL, never a test runner or NuGet substitute. -->
    <Reference Include="System.Collections.Immutable">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(RtwpProbeModPath)'))\System.Collections.Immutable.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
